# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real values.

# Public URL of this deployment, no trailing slash. Used to build the Google
# OAuth redirect URI ({PUBLIC_BASE_URL}/api/google/callback).
# On Vercel this falls back to https://$VERCEL_PROJECT_PRODUCTION_URL or
# https://$VERCEL_URL when unset.
PUBLIC_BASE_URL=http://localhost:3000

# --- Optional: Google Search Console + GA4 verification -------------------
# Without these, all website audits still work; only the Google tools are off.
# Create an OAuth client (type "Web application") in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 32 random bytes, base64. Encrypts stored Google tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# --- Token storage (required for Google tools on Vercel) ------------------
# Add the Upstash Redis integration from the Vercel Marketplace; it sets
# these automatically. Either naming pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# --- Optional --------------------------------------------------------------
# PageSpeed Insights API key for Core Web Vitals in the technical check.
# Works without a key at a low shared quota.
PAGESPEED_API_KEY=

# Override where expert-help recommendations point.
# INCREMENTORS_CONTACT_URL=https://www.incrementors.com/contact-us/

# Local development only: lets audits fetch localhost/private IPs so you can
# test against a site running on your machine. Ignored on Vercel production.
# AUDIT_ALLOW_PRIVATE_HOSTS=true

# Log every MCP request to the console.
# MCP_VERBOSE_LOGS=true
